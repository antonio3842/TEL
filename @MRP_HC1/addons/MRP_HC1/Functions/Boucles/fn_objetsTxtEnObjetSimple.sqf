    if !(_listeObjets isEqualType []) exitWith {
        diag_log "[MRP_HC1] [ObjetsTxtSimple] ERREUR: liste objets invalide (array attendu)";
    };

    private _total = count _listeObjets;
    diag_log format ["[MRP_HC1] [ObjetsTxtSimple] %1 objets a creer", _total];

    if (_total <= 0) exitWith {
        diag_log "[MRP_HC1] [ObjetsTxtSimple] Aucun objet a creer - Fin";
    };

    private _batchSize = 50;
    private _createdSimple = 0;
    private _createdVehicle = 0;
    private _createdFallback = 0;
    private _errors = 0;

    {
        _x params ["_classname", "_posATL", "_dir"];

        private _created = false;
        private _objSimple = objNull;
        private _cfg = configFile >> "CfgVehicles" >> _classname;
        private _isCfgClass = isClass _cfg;
        private _modelPath = "";
        private _hiddenSelections = [];
        private _hiddenSelectionTextures = [];
        private _mustCreateVehicle = false;

        if (_isCfgClass) then {
            _modelPath = getText (_cfg >> "model");
            _hiddenSelections = getArray (_cfg >> "hiddenSelections");
            _hiddenSelectionTextures = getArray (_cfg >> "hiddenSelectionsTextures");
            _mustCreateVehicle = ((count _hiddenSelections) > 0) || ((count _hiddenSelectionTextures) > 0);
        };

        // Les objets avec hiddenSelections doivent etre des objets de classe,
        // sinon les textures config (hiddenSelectionsTextures) ne s'appliquent pas.
        if (!_mustCreateVehicle) then {
            if (_modelPath != "") then {
                _objSimple = createSimpleObject [_modelPath, ATLToASL _posATL, false];
            };

            if (isNull _objSimple) then {
                _objSimple = createSimpleObject [_classname, ATLToASL _posATL, false];
            };

            if (!isNull _objSimple) then {
                _objSimple setPosATL _posATL;
                _objSimple setDir _dir;
                _createdSimple = _createdSimple + 1;
                _created = true;
            };
        };

        if (!_created) then {
            private _obj = createVehicle [_classname, _posATL, [], 0, "CAN_COLLIDE"];
            if (!isNull _obj) then {
                _obj setPosATL _posATL;
                _obj setDir _dir;

                // Re-application explicite des textures hidden selections
                // pour garantir le rendu identique aux objets de map.
                if (count _hiddenSelectionTextures > 0) then {
                    {
                        if (_x != "") then {
                            _obj setObjectTextureGlobal [_forEachIndex, _x];
                        };
                    } forEach _hiddenSelectionTextures;
                };

                if (_mustCreateVehicle) then {
                    _createdVehicle = _createdVehicle + 1;
                } else {
                    // Fallback createVehicle si SimpleObject a echoue.
                    _obj allowDamage false;
                    _obj enableSimulationGlobal false;
                    _createdFallback = _createdFallback + 1;
                };
                _created = true;
            };
        };

        if (!_created) then {
            _errors = _errors + 1;
            if (_errors <= 10) then {
                diag_log format ["[MRP_HC1] [ObjetsTxtSimple] Erreur creation: %1 @ %2", _classname, _posATL];
            };
        };

        if ((_forEachIndex mod _batchSize) isEqualTo 0 && _forEachIndex > 0) then {
            if ((_forEachIndex mod 500) isEqualTo 0) then {
                diag_log format [
                    "[MRP_HC1] [ObjetsTxtSimple] Progression: %1/%2 (%3%%)",
                    _forEachIndex,
                    _total,
                    round (_forEachIndex / _total * 100)
                ];
            };
            sleep 0.05;
        };
    } forEach _listeObjets;

    missionNamespace setVariable ["MRP_HC1_objetsTxtEnObjetSimple_done", true, true];

    private _timeEnd = diag_tickTime;
    diag_log format [
        "[MRP_HC1] [ObjetsTxtSimple] Termine: %1 simples, %2 vehicules(hiddens), %3 fallback, %4 erreurs, temps: %5s",
        _createdSimple,
        _createdVehicle,
        _createdFallback,
        _errors,
        (_timeEnd - _timeStart) toFixed 2
    ];
};
